# synth_block.tcl - Genus trial synthesis of one SoC block (STA-02), same Lab 01 flow as
# synth_accel.tcl: pre-synthesis checks -> syn_generic/map/opt -> post-synthesis checks -> files.
# Run from the repo root on the server: make synth-block B=<block>, or make synth-blocks for all.
# Environment: BLOCK = block name from the table below, CG=0 for the run without clock gating.
#
# Scan flops are forbidden (Sheet STA-02, lesson IMPSP-9099 in docs/flow_notes.md):
#   1. every SDFF* library cell gets dont_use, and Genus is told not to use scan flops for
#      normal flops (use_scan_seqs_for_non_dft false)
#   2. after synthesis the netlist is searched for SDFF* cells, and any hit is an ERROR.
#
# Each block gets its own SDC (written to the output folder): clock 20 ns on the block clock
# port, Lab 01 uncertainty and IO delay ratios, false path from the block reset port (the
# block reset goes straight to its flops, as in accel.sdc). The SoC SDC is soc.sdc (STA-03).
# rv32_core is not in the table: it has its own flow (make synth-core, syn/scripts/synth_core.tcl,
# docs/genus_core.md) with core.sdc and a period sweep, which also forbids SDFF*.

set REPO [file normalize [file dirname [info script]]/../..]
source $REPO/pnr/scripts/config.tcl

# Block table: name {top  files  clock  reset  parameters  uses_sram_macro}
# Parameters follow the soc_top defaults (one bus master, 16 KB per memory).
set ACCEL [list $REPO/rtl/accel/pe.v $REPO/rtl/accel/accelerator_top.v \
                $REPO/rtl/accel/accel_wrapper.v $REPO/rtl/accel/accel_apb.v]
set BLOCKS [dict create \
    sys_bus    [list sys_bus    [list $REPO/rtl/bus/sys_bus.v]    clk rst_n {} 0] \
    apb_bridge [list apb_bridge [list $REPO/rtl/bus/apb_bridge.v] clk rst_n {} 0] \
    dma_apb    [list dma_apb    [list $REPO/rtl/bus/dma_apb.v]    PCLK PRESETn {} 0] \
    imem_port  [list imem_port  [list $REPO/rtl/mem/sram_array.v $REPO/rtl/mem/sram_wrap.v \
                                      $REPO/rtl/mem/boot_rom.v $REPO/rtl/mem/imem_port.v] \
                                 clk rst_n {} 1] \
    sram_wrap  [list sram_wrap  [list $REPO/rtl/mem/sram_array.v $REPO/rtl/mem/sram_wrap.v] \
                                 clk rst_n {} 1] \
    timer_apb  [list timer_apb  [list $REPO/rtl/periph/timer_apb.v] PCLK PRESETn {} 0] \
    uart_apb   [list uart_apb   [list $REPO/rtl/periph/uart_fifo.v $REPO/rtl/periph/uart_apb.v] \
                                 PCLK PRESETn {} 0] \
    gpio_apb   [list gpio_apb   [list $REPO/rtl/periph/gpio_apb.v]  PCLK PRESETn {} 0] \
    irqc_apb   [list irqc_apb   [list $REPO/rtl/periph/irqc_apb.v]  PCLK PRESETn {} 0] \
    accel_apb  [list accel_apb  $ACCEL pclk presetn {} 0] \
]

if {![info exists ::env(BLOCK)] || ![dict exists $BLOCKS $::env(BLOCK)]} {
    puts "ERROR: set BLOCK to one of: [dict keys $BLOCKS]"
    quit
}
set BLOCK $::env(BLOCK)
lassign [dict get $BLOCKS $BLOCK] TOP FILES CLK RST PARAMS SRAM

set OUT   $REPO/syn/out_blocks/$BLOCK
set AUDIT $OUT/reports/audit
set RPT   $OUT/reports/synthesis
file mkdir $OUT $AUDIT $RPT
set CG [expr {[info exists ::env(CG)] ? $::env(CG) : 1}]

# Try a command: on error only warn and keep going (names differ between Genus versions)
proc try_cmd {cmd} {
    if {[catch {uplevel 1 $cmd} msg]} { puts "WARNING: command \"$cmd\" failed: $msg" }
}

# Libraries. The SRAM macro .lib is only read for blocks that contain the macro.
set_db init_lib_search_path [list $LIB_DIR]
set_db init_hdl_search_path [list $REPO/rtl/core $REPO/rtl/bus $REPO/rtl/mem]
set libs [list $LIB_SLOW]
if {$SRAM} {
    set sram_lib $PDK_DIR/lib/sram_2k_macro.lib
    if {![file exists $sram_lib]} {
        puts "ERROR: $sram_lib not found, needed by $BLOCK"
        quit
    }
    lappend libs $sram_lib
}
read_libs $libs

# Scan flop ban, layer 1: no SDFF* cell may be picked, and no scan flop for normal flops
foreach c [get_db lib_cells -if {.base_name == SDFF*}] { set_db $c .dont_use true }
try_cmd {set_db use_scan_seqs_for_non_dft false}
# Double-height cells, see DONT_USE_CELLS in config.tcl
foreach n $DONT_USE_CELLS {
    foreach c [get_db lib_cells -if ".base_name == $n"] { set_db $c .dont_use true }
}

# Clock gating must be enabled before elaborate, otherwise Genus ignores it (POPT-104)
if {$CG} { set_db lp_insert_clock_gating true }

read_hdl -language v2001 $FILES
if {[llength $PARAMS] == 0} {
    elaborate $TOP
} elseif {[catch {elaborate $TOP -parameters $PARAMS} msg]} {
    puts "ERROR: elaborate $TOP with parameters $PARAMS failed: $msg"
    quit
}

if {$CG && [catch {set_db [get_db designs] .lp_clock_gating_min_flops 4} msg]} {
    puts "WARNING: could not set lp_clock_gating_min_flops ($msg), using the Genus default"
}

# Block SDC, written to a file so it is kept with the reports
set sdc $OUT/${BLOCK}.sdc
set fp [open $sdc w]
puts $fp "# ${BLOCK}.sdc - generated by syn/scripts/synth_block.tcl for the block trial (STA-02)"
puts $fp "create_clock -name clk -period 20.0 -waveform {0 10.0} \[get_ports $CLK\]"
puts $fp "set_clock_uncertainty -setup 0.15 \[get_clocks clk\]"
puts $fp "set_clock_uncertainty -hold  0.08 \[get_clocks clk\]"
puts $fp "set_clock_transition 0.08 \[get_clocks clk\]"
puts $fp "set in_ports \[remove_from_collection \[all_inputs\] \[get_ports {$CLK $RST}\]\]"
puts $fp "set_input_delay  -clock clk -max 4.8 \$in_ports"
puts $fp "set_input_delay  -clock clk -min 0.3 \$in_ports"
puts $fp "set_output_delay -clock clk -max 4.0 \[all_outputs\]"
puts $fp "set_output_delay -clock clk -min 0.2 \[all_outputs\]"
puts $fp "set_driving_cell -lib_cell INVX2 \$in_ports"
puts $fp "set_load -pin_load 0.05 \[all_outputs\]"
puts $fp "set_false_path -from \[get_ports $RST\]"
puts $fp "set_input_delay -clock clk 0.0 \[get_ports $RST\]"
close $fp

# Pre-synthesis checks (Quality Gate 1)
check_design -unresolved > $AUDIT/pre_syn_unresolved.rpt     ;# Must be 0 unresolved
check_design -all        > $AUDIT/pre_syn_design_lint.rpt    ;# 0 latch, 0 loop, 0 multi-driven
read_sdc $sdc
check_timing_intent -verbose > $AUDIT/pre_syn_timing_intent.rpt  ;# 0 unconstrained endpoint

# 3-stage synthesis
set_db syn_generic_effort medium
set_db syn_map_effort     medium
set_db syn_opt_effort     medium
try_cmd {set_db remove_assigns true}

syn_generic
syn_map
syn_opt

# Netlist cleanup (Quality Gate 2)
try_cmd {remove_assigns_without_optimization}
try_cmd {set_db write_vlog_unconnected_port_style none}

set netlist $OUT/${BLOCK}_netlist.v
write_hdl > $netlist
write_sdc > $OUT/${BLOCK}_synth.sdc

try_cmd {check_design -all > $AUDIT/post_syn_design_lint.rpt}
try_cmd {report_qor          > $RPT/qor.rpt}
try_cmd {report_timing -lint > $RPT/timing_lint.rpt}
try_cmd {report_timing       > $RPT/timing.rpt}
try_cmd {report_area         > $RPT/area.rpt}
try_cmd {report_gates        > $RPT/gates.rpt}
try_cmd {report_power        > $RPT/power.rpt}
if {$CG} { try_cmd {report_clock_gating > $RPT/clock_gating.rpt} }

# Scan flop ban, layer 2: count cells in the written netlist (a cell instance line starts with
# the cell name followed by the instance name and an opening parenthesis)
set fp [open $netlist r]
set text [read $fp]
close $fp
set n_scan  [regexp -all -line {^\s*SDFF\w*\s+\S+\s*\(} $text]
set n_flop  [regexp -all -line {^\s*S?DFF\w*\s+\S+\s*\(} $text]
# Clock gating cells of gsclib045 are TLATNTSCA* or TLATNCA*, so they are not counted as latches
set n_icg   [regexp -all -line {^\s*(TLATNTSCA|TLATNCA)\w*\s+\S+\s*\(} $text]
set n_latch [expr {[regexp -all -line {^\s*TLAT\w*\s+\S+\s*\(} $text] - $n_icg}]
set wns ""
catch {set wns [get_db [get_db designs] .slack]}
if {$wns eq ""} { set wns "n/a" }

set fp [open $OUT/summary.txt w]
puts $fp "block=$BLOCK top=$TOP cg=$CG scan_flops=$n_scan flops=$n_flop latches=$n_latch\
icg=$n_icg wns_ps=$wns"
close $fp

if {$n_scan > 0} {
    puts "ERROR: $n_scan scan flops (SDFF*) in $netlist"
} else {
    puts "Genus done: $netlist (CG=$CG, 0 scan flops, $n_flop flops, WNS $wns ps)"
}
quit

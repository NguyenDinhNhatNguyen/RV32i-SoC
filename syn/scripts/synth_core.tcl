# synth_core.tcl - Genus synthesis of rv32_core alone, same flow as synth_accel.tcl (Lab 01):
# pre-synthesis checks -> syn_generic/map/opt -> post-synthesis checks -> write files.
# Run from the repo root on the server: make synth-core (steps in docs/genus_core.md)
#
# Environment variables:
#   CG=0|1          Clock gating (default 1). CG=0 is the baseline for the power comparison
#   PERIOD=<ns>     Clock period (default 20 = 50 MHz), replaces CORE_PERIOD in core.sdc
#   ENABLE_BTB=0|1  Branch prediction (default 1 = 8-entry BTB, the tape-out choice D-041)
#   SYN_OUT=<dir>   Output folder (default syn/out_core), used by sweep_core.sh
#
# ENABLE_M=1 and ENABLE_WFI_SLEEP=1 are fixed. RESET_PC is 0 so the netlist runs on tb_core
# (IMEM at 0) for GLS. In soc_top the core uses RESET_PC = boot ROM, which only changes the
# reset value of if_pc_q.

set REPO [file normalize [file dirname [info script]]/../..]
source $REPO/pnr/scripts/config.tcl

proc env_or {name def} {
    if {[info exists ::env($name)] && $::env($name) ne ""} { return $::env($name) }
    return $def
}

set TOP        rv32_core_syn
set CG         [env_or CG 1]
set PERIOD     [env_or PERIOD 20.0]
set ENABLE_BTB [env_or ENABLE_BTB 1]
set OUT        [file normalize [env_or SYN_OUT $REPO/syn/out_core]]
set AUDIT      $OUT/reports/audit
set RPT        $OUT/reports/synthesis
file mkdir $OUT $AUDIT $RPT

# Wrapper with the parameters fixed: Genus, Conformal (lec/core_rtl2gate.do) and the GLS
# testbench all see one top module without parameters, so the netlist module name is known
set f [open $OUT/rv32_core_syn.v w]
puts $f "// Generated by syn/scripts/synth_core.tcl (ENABLE_BTB=$ENABLE_BTB), do not edit"
puts $f "module rv32_core_syn ("
puts $f "    input  wire        clk,            input  wire        rst_n,"
puts $f "    output wire        if_req_o,       output wire \[31:0\] if_addr_o,"
puts $f "    input  wire        if_gnt_i,       input  wire \[31:0\] if_rdata_i,"
puts $f "    input  wire        if_err_i,"
puts $f "    output wire        d_req_valid_o,  input  wire        d_req_ready_i,"
puts $f "    output wire \[31:0\] d_addr_o,       output wire        d_we_o,"
puts $f "    output wire \[3:0\]  d_be_o,         output wire \[31:0\] d_wdata_o,"
puts $f "    input  wire        d_rsp_valid_i,  input  wire \[31:0\] d_rsp_rdata_i,"
puts $f "    input  wire        d_rsp_err_i,"
puts $f "    input  wire        irq_software_i, input  wire        irq_timer_i,"
puts $f "    input  wire        irq_external_i, input  wire \[63:0\] mtime_i,"
puts $f "    output wire        core_sleep_o"
puts $f ");"
puts $f "    rv32_core #("
puts $f "        .ENABLE_M(1), .ENABLE_WFI_SLEEP(1), .ENABLE_BTB($ENABLE_BTB), .BTB_ENTRIES(8),"
puts $f "        .RESET_PC(32'h0000_0000)"
puts $f "    ) u_core ("
foreach p {clk rst_n if_req_o if_addr_o if_gnt_i if_rdata_i if_err_i d_req_valid_o
           d_req_ready_i d_addr_o d_we_o d_be_o d_wdata_o d_rsp_valid_i d_rsp_rdata_i
           d_rsp_err_i irq_software_i irq_timer_i irq_external_i mtime_i} {
    puts $f "        .$p\($p\),"
}
puts $f "        .core_sleep_o(core_sleep_o)"
puts $f "    );"
puts $f "endmodule"
close $f

# SDC for this run: core.sdc with the CORE_PERIOD line replaced, so the I/O delays that scale
# with the period follow it
set f [open $REPO/syn/constraints/core.sdc r]
set sdc [read $f]
close $f
if {![regsub -line {^set CORE_PERIOD .*$} $sdc "set CORE_PERIOD $PERIOD" sdc]} {
    puts "ERROR: no \"set CORE_PERIOD\" line in syn/constraints/core.sdc"
    quit
}
set SDC $OUT/core_run.sdc
set f [open $SDC w]
puts -nonewline $f $sdc
close $f

# Libraries and RTL
set_db init_lib_search_path [list $LIB_DIR]
set_db init_hdl_search_path [list $REPO/rtl/core $OUT]
read_libs $LIB_SLOW

# No scan flops: a netlist with scan flops but no scan chain makes Innovus report IMPSP-9099
foreach c [get_db lib_cells -if {.base_name == SDFF*}] { set_db $c .dont_use true }
# Double-height cells, see DONT_USE_CELLS in config.tcl (BUFX2)
foreach n $DONT_USE_CELLS { foreach c [get_db lib_cells -if ".base_name == $n"] { set_db $c .dont_use true } }

# Clock gating must be enabled before elaborate, otherwise Genus ignores it (POPT-104)
if {$CG} { set_db lp_insert_clock_gating true }

# Verilog-2001 as in the Lab (no localparam inside generate, checked with iverilog -g2001)
set RTL [lsort [glob -directory $REPO/rtl/core rv32_*.v]]
read_hdl -language v2001 [concat $RTL [list $OUT/rv32_core_syn.v]]
elaborate $TOP

if {$CG && [catch {set_db [get_db designs] .lp_clock_gating_min_flops 4} msg]} {
    puts "WARNING: could not set lp_clock_gating_min_flops ($msg), using the Genus default"
}

# Pre-synthesis checks (Quality Gate 1)
check_design -unresolved > $AUDIT/pre_syn_unresolved.rpt     ;# Must be 0 unresolved
check_design -all        > $AUDIT/pre_syn_design_lint.rpt    ;# 0 latch, 0 loop, 0 multi-driven
read_sdc $SDC
check_timing_intent -verbose > $AUDIT/pre_syn_timing_intent.rpt  ;# 0 unconstrained endpoint

# 3-stage synthesis
set_db syn_generic_effort medium
set_db syn_map_effort     medium
set_db syn_opt_effort     medium

# Try a command: on error only warn and keep going (names differ between Genus versions)
proc try_cmd {cmd} {
    if {[catch {uplevel 1 $cmd} msg]} { puts "WARNING: command \"$cmd\" failed: $msg" }
}

# assign statements in the netlist break Innovus (attribute since Genus 21.1)
try_cmd {set_db remove_assigns true}

# Keep every flop so that LEC maps 1:1 with the RTL
catch {set_db optimize_merge_flops false}
catch {set_db optimize_merge_latches false}
catch {set_db optimize_constant_0_flops false}
catch {set_db optimize_constant_1_flops false}
catch {set_db delete_unloaded_seqs false}

syn_generic
syn_map
syn_opt

# Netlist cleanup (Quality Gate 2)
try_cmd {remove_assigns_without_optimization}
try_cmd {set_db write_vlog_unconnected_port_style none}

# Handoff files first, so a failing report still leaves a netlist.
# LEC uses lec/core_rtl2gate.do, not write_do_lec (needs Conformal_Ultra).
write_hdl > $OUT/${TOP}_netlist.v
write_sdc > $OUT/${TOP}_synth.sdc
try_cmd {write_sdf -timescale ns > $OUT/${TOP}.sdf}

try_cmd {check_design -all > $AUDIT/post_syn_design_lint.rpt}
try_cmd {report_qor                   > $RPT/qor.rpt}
try_cmd {report_timing -lint          > $RPT/timing_lint.rpt}
try_cmd {report_timing                > $RPT/timing.rpt}
try_cmd {report_timing -max_paths 10  > $RPT/timing_paths.rpt}
try_cmd {report_area                  > $RPT/area.rpt}
try_cmd {report_gates                 > $RPT/gates.rpt}
try_cmd {report_power                 > $RPT/power.rpt}
if {$CG} { try_cmd {report_clock_gating > $RPT/clock_gating.rpt} }

# One line for sweep_core.sh and docs/genus_core.md
set wns NA
try_cmd {set wns [get_db [get_db designs] .slack]}
set f [open $RPT/run_info.txt w]
puts $f "PERIOD=$PERIOD CG=$CG ENABLE_BTB=$ENABLE_BTB WNS_PS=$wns"
close $f

puts "Genus done: $OUT/${TOP}_netlist.v"
puts "  PERIOD=$PERIOD ns, CG=$CG, ENABLE_BTB=$ENABLE_BTB, WNS=$wns ps"
quit
